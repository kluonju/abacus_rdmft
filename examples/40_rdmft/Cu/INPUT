INPUT_PARAMETERS 
#Parameters (1.General)
suffix           autotest
calculation      scf
                 
nbands		18
symmetry         1
                 
#Parameters (2.Iteration)
ecutwfc          40
scf_thr          1e-6
scf_nmax         5
cal_force        0
cal_stress       0
#Parameters (3.Basis)
basis_type       lcao
                 
#Parameters (4.Smearing)
smearing_method  gauss
smearing_sigma   0.2
                 
#Parameters (5.Mixing)
mixing_type      broyden
#mixing_gg0       0
mixing_beta      0.3
#gamma_only       1
ks_solver        scalapack_gvx #genelpa

#Parameters (6.rdmft)
#
rdmft               1

rdmft_functional muller
rdmft_power_alpha 0.656

rdmft_solver_strategy   alternating
rdmft_occ_optimizer     cg
rdmft_orb_optimizer     cg
rdmft_max_iter          100
rdmft_energy_tol        1e-7

