&CONTROL
  calculation     = 'scf'
  restart_mode    = 'from_scratch'
  prefix          = 'fe'
  outdir          = './tmp/'
  pseudo_dir      = './'
  verbosity       = 'low'
/
&SYSTEM
  ibrav           = 3
  celldm(1)       = 5.42d0
  nat             = 1
  ntyp            = 1
  nspin           = 2
  starting_magnetization(1) = 0.4d0
  ecutwfc         = 35.0
  ecutrho         = 280.0
  occupations     = 'smearing'
  smearing        = 'gaussian'
  degauss         = 0.02
  nbnd            = 10
/
&ELECTRONS
  conv_thr        = 1.0d-7
  mixing_beta     = 0.4d0
  electron_maxstep = 60
/
ATOMIC_SPECIES
 Fe  55.845  Fe.pz-n-nc.UPF
ATOMIC_POSITIONS crystal
 Fe  0.0  0.0  0.0
K_POINTS automatic
 2 2 2 0 0 0

&rdmft
  do_rdmft              = .true.
  rdmft_functional      = 'hf'
  rdmft_outer_maxiter   = 0
  rdmft_occ_maxiter     = 0
  rdmft_orb_maxiter     = 0
  rdmft_occ_init_mode   = 'ks'
  rdmft_verbose         = 1
/
