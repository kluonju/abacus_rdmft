 &CONTROL
    calculation      = 'scf'
    restart_mode     = 'from_scratch'
    prefix           = 'lih'
    outdir           = './tmp/'
    pseudo_dir       = '../upf/'
    tprnfor          = .true.
 /
 &SYSTEM
    ibrav     = 0
    nat       = 2
    ntyp      = 2
    nspin     = 2
    starting_magnetization(1) = 0.d0
    starting_magnetization(2) = 0.d0
    ! ONCV PBE pseudos converge by ecutwfc ~ 40 Ry; ecutrho = 4*ecutwfc
    ! is the canonical norm-conserving setting (anything beyond 4* is
    ! wasted work and triggers QE's "no reason to have ecutrho > 4*ecutwfc"
    ! warning).  The earlier values (ecutwfc=70, ecutrho=560 on a
    ! 20-A box) drove the dense FFT grid to 288^3 ~ 24 M points, so
    ! every ACE/aceinit inside the RDMFT line search took ~30 s per
    ! trial - the calculation looked stuck while in fact each outer
    ! cycle requires dozens of energy evaluations.
    ecutwfc   = 40.0
    ecutrho   = 160.0
    occupations = 'smearing'
    smearing  = 'gaussian'
    degauss   = 0.01
    assume_isolated = 'mt'
    input_dft = 'pbe'
    nbnd      = 10
    tot_charge = -0.2
 /
 &ELECTRONS
    ! Tight enough convergence so that the RDMFT optimiser starts from
    ! a well-defined KS reference.  The previous setup used
    ! electron_maxstep = 2 with conv_thr = 1e-2, which left the SCF
    ! orbitals far from a stationary point and confused the
    ! subsequent RDMFT line search.
    conv_thr        = 1.0d-7
    mixing_beta     = 0.4d0
    electron_maxstep = 60
 /
CELL_PARAMETERS angstrom
 12.0  0.0  0.0
  0.0 12.0  0.0
  0.0  0.0 12.0
ATOMIC_SPECIES
 Li  6.941   Li_ONCV_PBE-1.0.upf
 H   1.008   H_ONCV_PBE-1.0.upf
ATOMIC_POSITIONS angstrom
 Li  0.000000000  0.000000000  0.000000000
 H   0.000000000  0.000000000  1.594900000
K_POINTS {gamma}

&rdmft
  ! HF post-processing on a fractionally-charged LiH cluster.  The
  ! alternating driver runs an occupation step (projected gradient on
  ! the natural occupations) followed by an orbital Stiefel step.
  ! Iteration budgets are deliberately modest: every Armijo trial in
  ! the orbital block triggers a full exxinit + aceinit rebuild, so
  ! the total wall time scales roughly linearly with
  !
  !   rdmft_outer_maxiter * (rdmft_occ_maxiter + rdmft_orb_maxiter)
  !
  ! Tighten these if the energy is not yet converged at the end of
  ! the log.
  do_rdmft              = .true.
  rdmft_functional      = 'hf'
  rdmft_solver_strategy = 'joint'
  rdmft_joint_optimizer = 'cg'
  rdmft_orb_strategy    = 'joint'
  rdmft_outer_maxiter   = 5
  rdmft_occ_maxiter     = 5
  rdmft_orb_maxiter     = 5
  rdmft_energy_tol      = 1.0d-7
  rdmft_occ_grad_tol    = 1.0d-5
  rdmft_orb_grad_tol    = 1.0d-5
  rdmft_occ_tol         = 1.0d-6
  ! ABACUS-style Fermi-window seed (delta=1e-3, K=1 for minimal nudge).
  rdmft_occ_init_mode       = 'perturbed'
  rdmft_occ_init_perturb    = 1.0d-3
  rdmft_occ_init_nbands_top = 1
  rdmft_verbose         = 1
/
