! H2 RDMFT run with a uniform k-mesh for EMD post-processing.
! Step 2: rdmft_emd.x < h2.step2.in
&CONTROL
  calculation = 'scf'
  prefix      = 'h2'
  outdir      = './tmp'
  pseudo_dir  = './'
  verbosity   = 'high'
/
&SYSTEM
  ibrav     = 1
  celldm(1) = 12.0
  nat       = 2
  ntyp      = 1
  ecutwfc   = 25.0
  ecutrho   = 100.0
  nbnd      = 4
  assume_isolated = 'martyna-tuckerman'
  input_dft = 'hf'
  ace = .true.
  exxdiv_treatment = 'gygi-baldereschi'
  x_gamma_extrapolation = .false.
/
&ELECTRONS
  conv_thr    = 1.0d-8
  mixing_beta = 0.5d0
/
ATOMIC_SPECIES
H 1.00 H_HSCV_PBE-1.0.UPF
ATOMIC_POSITIONS {angstrom}
H 0.0 0.0 0.0
H 0.0 0.0 0.74
K_POINTS automatic
  4 4 4 0 0 0
&rdmft
  do_rdmft                 = .true.
  rdmft_functional         = 'muller'
  rdmft_outer_maxiter      = 8
  rdmft_occ_maxiter        = 12
  rdmft_orb_maxiter        = 4
  rdmft_energy_tol         = 1.0d-7
  rdmft_occ_grad_tol       = 1.0d-5
  rdmft_orb_grad_tol       = 1.0d-5
  rdmft_occ_init_mode      = 'perturbed'
  rdmft_occ_init_perturb   = 0.05d0
  rdmft_save_every         = 1
/
