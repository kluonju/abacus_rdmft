 &CONTROL
    calculation = 'scf'
    restart_mode = 'from_scratch'
    prefix = 'nio'
    outdir = './tmp/'
    pseudo_dir = './'
 /
 &SYSTEM
    ibrav     = 0
    nat       = 2
    ntyp      = 2
    nspin     = 1
    nbnd      = 32
    ecutwfc   = 80.0
    occupations = 'smearing'
    smearing = 'gaussian'
    degauss = 0.001
    input_dft = 'pbe'
 /
 &ELECTRONS
    conv_thr    = 1.0d-6
    mixing_beta = 0.25
    electron_maxstep = 50
 /
CELL_PARAMETERS bohr
  3.946800  3.946800  0.000000
  3.946800  0.000000  3.946800
  0.000000  3.946800  3.946800
ATOMIC_SPECIES
 Ni  58.6934  Ni_ONCV_PBE-1.0.upf
 O   15.999   O_ONCV_PBE-1.0.upf
ATOMIC_POSITIONS crystal
 Ni  0.000  0.000  0.000
 O   0.500  0.500  0.500
K_POINTS automatic
 2 2 2 0 0 0

&rdmft
  do_rdmft = .true.
  rdmft_functional = 'power'
  rdmft_power_alpha = 0.65
  rdmft_solver_strategy = 'alternating'
  rdmft_orb_optimizer = 'cg'
  rdmft_orb_strategy = 'joint'

  rdmft_outer_maxiter = 10
  rdmft_occ_maxiter = 50
  rdmft_orb_maxiter = 5
  rdmft_energy_tol      = 1.0d-5
  rdmft_occ_grad_tol    = 1.0d-4
  rdmft_orb_grad_tol    = 1.0d-4
  rdmft_occ_tol         = 1.0d-7

  rdmft_orb_precond_shift = 0.5
  rdmft_verbose = 1
/
