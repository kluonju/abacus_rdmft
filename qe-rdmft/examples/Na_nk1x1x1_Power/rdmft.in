 &CONTROL
    calculation = 'scf'
    restart_mode = 'from_scratch'
    prefix = 'na'
    outdir = './tmp/'
    pseudo_dir = './'
 /
 &SYSTEM
    ibrav     = 3
    celldm(1) = 8.108058
    nat       = 1
    ntyp      = 1
    nspin     = 1
    nbnd      = 12
    ecutwfc   = 70.0
    occupations = 'smearing'
    smearing = 'gaussian'
    degauss = 0.001
    input_dft = 'pbe'
    nqx1 = 1
    nqx2 = 1
    nqx3 = 1
 /
 &ELECTRONS
    conv_thr    = 1.0d-6
    mixing_beta = 0.25
    electron_maxstep = 50
 /
ATOMIC_SPECIES
 Na  22.989769  Na_ONCV_PBE-1.0.upf
ATOMIC_POSITIONS crystal
 Na  0.000  0.000  0.000
K_POINTS automatic
 1 1 1 0 0 0


&rdmft
  do_rdmft = .true.
  rdmft_functional = 'power'
  rdmft_power_alpha = 0.65
  rdmft_solver_strategy = 'alternating'
  rdmft_orb_optimizer = 'cg'
  rdmft_orb_strategy = 'joint'
  !rdmft_orb_strategy = 'block_k'
  rdmft_block_order   = 'orb_occ'

  ! The alternating solver must run enough OUTER cycles to couple the
  ! occupation and orbital sub-problems.  With rdmft_outer_maxiter = 1
  ! only a single partial sweep is performed, so the result still
  ! reflects the initial occupations (rdmft_occ_init_mode) instead of a
  ! converged minimum -- different initial occupations then give very
  ! different total energies.  Iterate until |dE| < rdmft_energy_tol.
  rdmft_outer_maxiter = 100
  rdmft_occ_maxiter = 100
  rdmft_orb_maxiter = 10 
  rdmft_energy_tol      = 1.0d-6
  rdmft_occ_grad_tol    = 1.0d-4
  rdmft_orb_grad_tol    = 1.0d-4
  rdmft_occ_tol         = 1.0d-7

  rdmft_occ_init_mode = 'perturbed'
  rdmft_occ_init_perturb = 1.0d-2
  rdmft_occ_init_nbands_top = 2
/
