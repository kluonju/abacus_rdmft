INPUT_PARAMETERS 
#Parameters (1.General)
#suffix           autotest
calculation      scf
                 
symmetry         1

#Parameters (2.Iteration)
scf_thr          1e-5
scf_nmax         100
cal_force        0
cal_stress       0

#Parameters (3.Basis)
basis_type       lcao

#Parameters (4.Smearing)
smearing_method  gaussian
smearing_sigma   0.015

#Parameters (5.Mixing)
mixing_type      broyden
mixing_beta      0.5
ks_solver        scalapack_gvx

#Parameters (6.RDMFT)
# Enable RDMFT stage (true/false)
rdmft            true

# Use the main DFT functional as the RDMFT functional (set via dft_functional)
dft_functional muller

# Power-functional exponent alpha (0<alpha<1). For hf/pbe0 and muller
# this value is overridden automatically by the reader, but you may set it.
rdmft_power_alpha 0.656

